# Copy to .env before running docker compose.
POSTGRES_DB=paperforge
POSTGRES_USER=paperforge
POSTGRES_PASSWORD=replace-with-a-random-database-password
# Required in production; generate a long random value and keep it out of git.
JWT_SECRET_KEY=
APP_ENV=local
JWT_EXPIRE_MINUTES=1440
DEEPSEEK_API_KEY=
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000
