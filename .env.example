# Copy to .env before running docker compose.
POSTGRES_DB=paperforge
POSTGRES_USER=paperforge
POSTGRES_PASSWORD=replace-with-a-random-database-password
# Required in production; generate a long random value and keep it out of git.
JWT_SECRET_KEY=
APP_ENV=local
JWT_EXPIRE_MINUTES=1440
DEEPSEEK_API_KEY=
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000
# Monthly Agent-run quota per tenant; Day13 P0 default is 100.
DEFAULT_AGENT_RUN_QUOTA=100
# Process-local baseline API limit; production must also enforce limits at the edge/WAF.
API_RATE_LIMIT_PER_MINUTE=600
# Active task admission limits. Pending and running tasks both consume a slot.
MAX_ACTIVE_TASKS_PER_USER=2
MAX_ACTIVE_TASKS_PER_TENANT=4
# DOCX archive safety limits.
MAX_DOCX_UNCOMPRESSED_BYTES=314572800
MAX_DOCX_ARCHIVE_ENTRIES=5000
MAX_DOCX_COMPRESSION_RATIO=200
MAX_UPLOAD_FILENAME_LENGTH=320
MAX_REQUEST_BODY_BYTES=251658240
# Optional comma-separated platform-admin emails for the aggregate /admin dashboard.
# ADMIN_EMAILS=ops@example.com
