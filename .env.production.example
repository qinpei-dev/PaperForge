# Copy outside Git as the production environment file. Never commit real values.
PAPERFORGE_RELEASE_VERSION=v3.7.2
PAPERFORGE_BACKEND_IMAGE=registry.example.com/paperforge/paperforge-backend:v3.7.2
PAPERFORGE_FRONTEND_IMAGE=registry.example.com/paperforge/paperforge-frontend:v3.7.2
PAPERFORGE_POSTGRES_IMAGE=postgres:16.4-alpine
POSTGRES_DB=paperforge
POSTGRES_USER=paperforge
POSTGRES_PASSWORD=replace-with-a-long-random-password
JWT_SECRET_KEY=replace-with-a-long-random-jwt-secret
# Preview auto-login is development-only and must remain disabled in production.
PAPERFORGE_PREVIEW_AUTO_LOGIN=false
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
# Browser-visible API URL; set this before building the immutable frontend image.
NEXT_PUBLIC_API_BASE_URL=https://api.example.com
CORS_ORIGINS=https://app.example.com
# Monthly Agent-run quota per tenant; Day13 P0 default is 100.
DEFAULT_AGENT_RUN_QUOTA=100
# Process-local guard; configure a distributed limit at the public edge as well.
API_RATE_LIMIT_PER_MINUTE=600
MAX_ACTIVE_TASKS_PER_USER=2
MAX_ACTIVE_TASKS_PER_TENANT=4
MAX_DOCX_UNCOMPRESSED_BYTES=314572800
MAX_DOCX_ARCHIVE_ENTRIES=5000
MAX_DOCX_COMPRESSION_RATIO=200
MAX_UPLOAD_FILENAME_LENGTH=320
MAX_REQUEST_BODY_BYTES=251658240
# Production schema is migration-owned; do not let the app auto-create tables.
AUTO_CREATE_DB=false
# SQLAlchemy connection pool safety defaults.
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_POOL_RECYCLE_SECONDS=1800
# Expired, unreferenced temporary/input files are eligible for maintenance cleanup.
PAPERFORGE_RETENTION_DAYS=30
# Required for platform-admin access; keep the allowlist private and comma-separated.
# ADMIN_EMAILS=ops@example.com
