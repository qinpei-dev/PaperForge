DEEPSEEK_API_KEY=你的 DeepSeek API Key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_MAX_INPUT_CHARS=7000
DEEPSEEK_MAX_OUTPUT_TOKENS=1200
# Required on Render. Generate a long random value and keep it secret.
BACKEND_SHARED_SECRET=
# 20 MB per uploaded DOCX; runtime files expire after one hour.
MAX_UPLOAD_BYTES=20971520
RUNTIME_FILE_TTL_SECONDS=3600
# Optional. Use this when direct HTTPS cannot reach DeepSeek.
# API_PROXY_URL=http://127.0.0.1:7897
