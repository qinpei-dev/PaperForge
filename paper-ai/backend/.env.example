DEEPSEEK_API_KEY=你的 DeepSeek API Key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_MAX_INPUT_CHARS=7000
DEEPSEEK_MAX_OUTPUT_TOKENS=1200
# Optional comma-separated browser origins for hosted deployments.
# Local defaults remain http://localhost:3000 and http://127.0.0.1:3000.
# CORS_ORIGINS=https://paperforge.example.com
# Optional. Use this when direct HTTPS cannot reach DeepSeek.
# API_PROXY_URL=http://127.0.0.1:7897
