DEEPSEEK_API_KEY=你的 DeepSeek API Key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_MAX_INPUT_CHARS=7000
DEEPSEEK_MAX_OUTPUT_TOKENS=1200
DATABASE_URL=postgresql+psycopg://paperforge:paperforge@localhost:5432/paperforge
# Required in production; generate a long random value and keep it out of git.
JWT_SECRET_KEY=
APP_ENV=local
JWT_EXPIRE_MINUTES=1440
POSTGRES_DB=paperforge
POSTGRES_USER=paperforge
POSTGRES_PASSWORD=请替换为数据库随机密码
# Local compatibility defaults to false. Docker SaaS deployment should set true.
AUTH_REQUIRED=false
# Development-only opt-in. Production always rejects the Preview login route.
PAPERFORGE_PREVIEW_AUTO_LOGIN=false
# Optional; must remain a reserved .local address.
# PAPERFORGE_PREVIEW_USER_EMAIL=preview@paperforge.local
# Local mode may auto-create tables; production should run Alembic migrations.
AUTO_CREATE_DB=true
# Optional comma-separated browser origins for hosted deployments.
# Local defaults remain http://localhost:3000 and http://127.0.0.1:3000.
# CORS_ORIGINS=https://paperforge.example.com
# Optional. Use this when direct HTTPS cannot reach DeepSeek.
# API_PROXY_URL=http://127.0.0.1:7897
# Monthly Agent-run quota per tenant; Day13 P0 default is 100.
DEFAULT_AGENT_RUN_QUOTA=100
# Process-local baseline API limit; production must also enforce limits at the edge/WAF.
API_RATE_LIMIT_PER_MINUTE=600
MAX_ACTIVE_TASKS_PER_USER=2
MAX_ACTIVE_TASKS_PER_TENANT=4
MAX_DOCX_UNCOMPRESSED_BYTES=314572800
MAX_DOCX_ARCHIVE_ENTRIES=5000
MAX_DOCX_COMPRESSION_RATIO=200
MAX_UPLOAD_FILENAME_LENGTH=320
MAX_REQUEST_BODY_BYTES=251658240
# SQLAlchemy connection pool settings for PostgreSQL.
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_POOL_RECYCLE_SECONDS=1800
# Optional comma-separated platform-admin emails for the aggregate /admin dashboard.
# ADMIN_EMAILS=ops@example.com
# Maintenance cleanup window for expired, unreferenced local files.
PAPERFORGE_RETENTION_DAYS=30
